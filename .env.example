# Never commit secrets. Configure the corresponding GitHub Actions secrets.
COVERR_API_KEY=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Optional: only if tracks are officially marked downloadable and you own rights
SC_ALLOW_OFFICIAL_DOWNLOADS=false
# Public user profile, no private track scraping:
SOUNDCLOUD_PROFILE_URL=https://soundcloud.com/carlecool
# OR provide a local data/tracks.json with 20 track objects for offline preview
# Original owned music in assets/audio/<track numeric id>.mp3 or S3 bucket:
AUDIO_S3_BUCKET=
STOCK_S3_BUCKET=
AUDIO_S3_PREFIX=carlecool/audio/
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Meta/Facebook Login for Business, Instagram professional account linked to a Facebook Page
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v24.0
# Live posting requires BOTH flags and valid credentials:
PUBLISH_ENABLED=false
COVERR_PUBLISH_PERMISSION_CONFIRMED=false
# Optional only if Coverr offers source/license terms consistent with your attribution approach
REEL_SECONDS=30
POST_COOLDOWN_DAYS=19
# Restrict external download hosts to known media domains (extend only after verification)
VIDEO_ALLOWED_HOSTS=coverr.co,*.coverr.co,*.cloudfront.net
