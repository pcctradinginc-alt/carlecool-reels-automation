name = "carlecool-approval"
main = "src/index.js"
compatibility_date = "2026-11-18"
workers_dev = true

# Run: npx wrangler d1 create carlecool-approvals
# Insert the returned database_id (never guess) into a local wrangler.toml.
[[d1_databases]]
binding = "DB"
database_name = "carlecool-approvals"
database_id = "REPLACE_WITH_REAL_DATABASE_ID"

[vars]
GITHUB_REPOSITORY = "pcctradinginc-alt/carlecool-reels-automation"

# Secrets set only by: npx wrangler secret put APPROVAL_LINK_SECRET
#                       npx wrangler secret put GITHUB_APPROVAL_TOKEN
